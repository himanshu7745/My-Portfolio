# Copy to .env.local (and add the same keys in Vercel → Project → Settings → Environment Variables).

# Spotify "now playing" widget — see README → Spotify. Leave empty to show the fallback playlist only.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional: your public URL, used for social-preview links.
NEXT_PUBLIC_SITE_URL=
